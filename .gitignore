# Ignore everything by default, then explicitly allow source files and
# directories. This way any compiled binary (no file extension) is
# automatically ignored without needing to list it here by name.
*
!*/
!*.cpp
!*.h
!*.hpp
!*.md
!.gitignore

# Extra safety net for known binary/debug artifacts
*.o
*.out
*.exe
*.dSYM/

# macOS
.DS_Store

# VS Code
.vscode/*
!.vscode/tasks.json
